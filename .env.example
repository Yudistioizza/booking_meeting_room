APP_NAME=Ruang
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Ruang: perusahaan & kebijakan ─────────────────────────
COMPANY_NAME="PT Nusantara Teknologi"
APP_TIMEZONE=Asia/Jakarta
BOOKING_HOURS_FROM=07:00
BOOKING_HOURS_TO=20:00
BOOKING_MAX_ADVANCE_DAYS=90

# ── Email (SMTP perusahaan / Microsoft 365) ───────────────
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=rooms@perusahaan.com
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=rooms@perusahaan.com
# QUEUE_CONNECTION=database   # jalankan: php artisan queue:work

# ── Single sign-on Microsoft Entra ID ─────────────────────
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI="${APP_URL}/login/azure/callback"
SSO_ALLOWED_DOMAINS=perusahaan.com

# ── Kalender Outlook (Microsoft Graph, opsional) ──────────
GRAPH_ORGANIZER=rooms@perusahaan.com
# GRAPH_CLIENT_ID / GRAPH_CLIENT_SECRET / GRAPH_TENANT_ID default ke nilai AZURE_*

# ── Notifikasi Teams / Slack (opsional) ───────────────────
BOOKING_WEBHOOK_URL=
